.env
out/
bin/
obj/
# Cache za běhu jen v kořeni a v src/. Neukotvené „cache/“ by na Windows (core.ignorecase) skrylo i zdrojovou složku src/EshopGuard.Core/Cache/.
/cache/
/src/cache/
*.sqlite
*.sqlite-shm
*.sqlite-wal
TestResults/
.vs/
*.user

# Podklady: do gitu jen vlastní rešerše a texty zákonů (.txt); stažené originály a cizí dokumenty mimo git
podklady/*
!podklady/README.md
!podklady/reserse/
!podklady/predpisy-sk/
!podklady/predpisy-cz/
!podklady/predpisy-eu/
podklady/predpisy-*/**/*.html
podklady/predpisy-*/**/*.xhtml
podklady/predpisy-*/**/*.pdf
