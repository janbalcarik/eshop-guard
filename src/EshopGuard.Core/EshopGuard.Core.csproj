<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EshopGuard.Core</RootNamespace>
    <PackageId>EshopGuard.Core</PackageId>
    <Description>Screening of e-shop texts for risky environmental claims and missing mandatory consumer information using the Jev model.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EshopGuard.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="SmartReader" />
    <PackageReference Include="System.Threading.RateLimiting" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
