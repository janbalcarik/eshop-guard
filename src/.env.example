# Zkopírujte do .env a doplňte. Soubor .env se necommituje.

# Klíč API Jevu (TypeSafe). Když chybí, použije se proměnná prostředí TYPESAFE_API_KEY.
JEV_API_KEY=

# Adresa endpointu. Přes OpenRouter: https://openrouter.ai/api/v1/systemone
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Model zafixovaný na konkrétní verzi. Přes OpenRouter: jev-1.13
JEV_MODEL=jev-1.13.0

# Klíč API OpenAI pro příkaz rewrite. Když chybí, použije se proměnná prostředí OPENAI_API_KEY.
OPENAI_API_KEY=

# Platby (změna 12): API a worker čtou klíče z user-secrets (eshopguard-api, eshopguard-worker) nebo z proměnných
# prostředí s těmito názvy, CLI je nepotřebuje. Mode: test, live (jen Production) nebo disabled (jen mimo Production).
# Billing__Stripe__Mode=test
Billing__Stripe__SecretKey=
Billing__Stripe__WebhookSecret=
Billing__SuperFaktura__Email=
Billing__SuperFaktura__ApiKey=
Billing__SuperFaktura__CompanyId=
