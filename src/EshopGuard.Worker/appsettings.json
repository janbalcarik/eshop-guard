{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Worker": {
    "Slots": {
      "fetch": 100,
      "jev": 8,
      "llm": 4,
      "io": 4,
      "system": 2,
      "cpu": 2
    },
    "TenantCaps": {
      "fetch": 20,
      "cpu": 4,
      "jev": 4,
      "llm": 2,
      "io": 4,
      "system": 0
    },
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "MinPollMilliseconds": 500,
    "MaxPollSeconds": 5,
    "ShutdownSeconds": 90
  },
  "Jobs": {
    "DefaultMaxAttempts": 5,
    "Retry": {
      "BaseSeconds": 10,
      "MaxSeconds": 900
    }
  },
  "Scheduler": {
    "Enabled": true,
    "TickSeconds": 15
  },
  "Storage": {
    "Provider": "FileSystem"
  },
  "EshopGuard": {
    "BaseDirectory": ".",
    "Crawl": {
      "UserAgent": "EshopGuard/0.1 (+mailto:doplnte-kontakt@example.cz)"
    },
    "Jev": {
      "UseMock": false
    },
    "Rewrite": {
      "UseMock": false
    }
  },
  "Runs": {
    "FetchBatchPages": 100,
    "FetchBatchSeconds": 60,
    "SieveBatchChunks": 200,
    "EvaluateBatchSegments": 200,
    "RewriteBatchPages": 25,
    "UsageFlushEvery": 50,
    "SiteOutageMaxHours": 24,
    "CostAlertRatio": 1.5,
    "QuestionLanguage": "en",
    "FreeSample": {
      "MaxPages": 100,
      "MaxInternalUsd": 1.0,
      "MaxExampleAttempts": 3
    },
    "FullAnalysis": {
      "MaxPages": 20000,
      "SampleProducts": 20000
    }
  }
}
