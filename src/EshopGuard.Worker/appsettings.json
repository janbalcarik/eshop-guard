{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Worker": {
    "Slots": { "fetch": 100, "jev": 8, "llm": 4, "io": 4, "system": 2 },
    "TenantCaps": { "fetch": 20, "cpu": 4, "jev": 4, "llm": 2, "io": 4, "system": 0 },
    "LeaseSeconds": 120,
    "HeartbeatSeconds": 30,
    "MinPollMilliseconds": 500,
    "MaxPollSeconds": 5,
    "ShutdownSeconds": 90
  },
  "Jobs": {
    "DefaultMaxAttempts": 5,
    "Retry": { "BaseSeconds": 10, "MaxSeconds": 900 }
  },
  "Scheduler": {
    "Enabled": true,
    "TickSeconds": 15
  },
  "Storage": {
    "Provider": "FileSystem"
  }
}
