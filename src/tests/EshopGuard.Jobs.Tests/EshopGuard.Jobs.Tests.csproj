<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\EshopGuard.Jobs\EshopGuard.Jobs.csproj" />
    <ProjectReference Include="..\..\EshopGuard.Data\EshopGuard.Data.csproj" />
    <ProjectReference Include="..\..\EshopGuard.Storage\EshopGuard.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\InMemoryLoggerProvider.cs" Link="Shared\InMemoryLoggerProvider.cs" />
    <!-- Runs of change 8 over the fixture e-shops of the library, with its shipped rules (the same files as the CLI tests). -->
    <Compile Include="..\EshopGuard.Core.Tests\FileSystemPageFetcher.cs" Link="Runs\Support\FileSystemPageFetcher.cs" />
    <None Include="..\EshopGuard.Core.Tests\Fixtures\site\**\*" Link="Fixtures\site\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EshopGuard.Core.Tests\Fixtures\site-sk\**\*" Link="Fixtures\site-sk\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\EshopGuard.Core.Tests\Fixtures\platforms\**\*" Link="Fixtures\platforms\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\*.yaml" Link="rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\question-set-hashes.json" Link="rules\question-set-hashes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\rules\texts\**\*.yaml" Link="rules\texts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\jurisdictions.yaml" Link="config\jurisdictions.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\labels.yaml" Link="config\labels.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\legal_requirements.yaml" Link="config\legal_requirements.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\sieve.yaml" Link="config\sieve.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\rewrite.yaml" Link="config\rewrite.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\platforms.yaml" Link="config\platforms.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
