{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "FileSystem"
  },
  "Frontend": {
    "BaseUrl": "",
    "LoginPath": "/prihlasenie",
    "LoginLinkPath": "/prihlasenie/odkaz",
    "ResetPath": "/prihlasenie/nove-heslo",
    "InvitationPath": "/pozvanka",
    "RunPath": "/app/{tenantId}/behy/{runId}",
    "MembersPath": "/app/{tenantId}/nastavenia/clenovia"
  },
  "Auth": {
    "Password": {
      "MinLength": 10
    },
    "Lockout": {
      "MaxFailedAttempts": 5,
      "Minutes": 15
    },
    "LoginLinkMinutes": 15,
    "LinkCooldownSeconds": 60,
    "ResetLinkMinutes": 60,
    "ReauthenticationMinutes": 15,
    "SessionDays": 30,
    "SecurityStampValidationMinutes": 5
  },
  "Invitations": {
    "ValidDays": 7
  },
  "Email": {
    "From": "no-reply@eshopguard.sk",
    "FromName": "EshopGuard",
    "SendTimeoutSeconds": 10,
    "MaxAttempts": 8,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls"
    }
  },
  "Localization": {
    "DefaultMarket": "sk",
    "TimeZone": "Europe/Bratislava"
  },
  "Tenants": {
    "MaxOwnedPerUser": 20
  },
  "Legal": {
    "TermsVersion": "0",
    "PrivacyVersion": "0"
  },
  "RateLimiting": {
    "AuthPerMinute": 30,
    "PerMinute": 300
  }
}
