<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>eshopguard</AssemblyName>
    <RootNamespace>EshopGuard.Cli</RootNamespace>
    <!-- ConnectionStrings:Cli (the cache in PostgreSQL), set by deploy/dev/setup-local.ps1. -->
    <UserSecretsId>eshopguard-cli</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EshopGuard.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EshopGuard.Core\EshopGuard.Core.csproj" />
    <ProjectReference Include="..\EshopGuard.Data\EshopGuard.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
